{
  "name": "whatsapp-claude-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge tra WhatsApp Cloud API e Claude per bot di business",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx src/setup/wizard.ts",
    "doctor": "tsx src/setup/doctor.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
