# Sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Dipendenze e build
node_modules/
# anche come symlink: nuova-lezione.sh ne crea uno a /opt/node22, che e' un
# percorso della macchina e non deve entrare nel repo
node_modules
dist/
build/
.cache/

# Ambiente
.env
.env.local

# Produzione video — tutto quello che gli script rigenerano
__pycache__/
*.pyc

# derivati del copione
progetti/*/copione/blocchi.json
progetti/*/copione/chunk*.txt

# derivati dell'audio (la voce costa: si tiene fuori dal repo)
progetti/*/audio/*.mp3
progetti/*/audio/prova.json
progetti/*/audio/blocchi-audio.json
progetti/*/audio/esiti-*.json
progetti/*/audio/blocchi/

# derivati delle slide e del montaggio
progetti/*/slide/png/
progetti/*/slide/mp4/
progetti/*/slide/troppo-alte.json
progetti/*/scene/*.mp4
progetti/*/montato-*.mp4
progetti/*/montato-*.srt

# cartelle di lavoro degli script e stato dei tagli
progetti/*/_montaggio/
progetti/*/audio/_prova/
progetti/*/audio/confini-*.json

# Le trascrizioni NON sono ignorate: costano, e sono la prova che la voce ha
# detto tutto. Quelle si tengono.
