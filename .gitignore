# --- prodotti di una lavorazione (MASTER §3) -------------------------------
# Tutto quello che qui sotto si rigenera dagli strumenti e dai due file scritti
# a mano (copione/costruisci.py e slide/contenuti.mjs). L'unica cosa che NON si
# rigenera e' la voce: grezzo-A.mp3 e grezzo-B.mp3 costano soldi veri, e se
# servono vanno tenuti fuori dal repository — un mp3 non sta in git.

# il copione compilato
progetti/*/copione/blocchi.json

# la voce e i suoi ritagli
progetti/*/audio/grezzo-*.mp3
progetti/*/audio/pulito-*.mp3
progetti/*/audio/prova.mp3
progetti/*/audio/prova.json
progetti/*/audio/_prova/
progetti/*/audio/blocchi/
progetti/*/audio/confini-*.json
progetti/*/audio/blocchi-audio.json
progetti/*/audio/esiti-*.json
progetti/*/audio/trascrizioni/*.txt

# le slide e le clip
progetti/*/slide/png/
progetti/*/slide/mp4/
progetti/*/slide/fotogrammi/
progetti/*/slide/troppo-alte.json

# il montaggio
progetti/*/scene/
progetti/*/_montaggio/
progetti/*/montato-*.mp4
progetti/*/montato-*.srt

# il marchio del committente: non e' un file del metodo
progetti/*/slide/marchio/logo-rifilato.png

# il video unico: la voce generata (costa, e un mp3 non sta in git)
progetti/bustapaga-video-unico/audio/grezzo/
progetti/bustapaga-video-unico/copione/blocchi.json
progetti/bustapaga-video-unico/copione/tracce.json
progetti/bustapaga-video-unico/audio/chunk/
progetti/bustapaga-video-unico/audio/lavorate/
progetti/bustapaga-video-unico/audio/tracce-misurate.json
progetti/bustapaga-video-unico/audio/blocchi/
progetti/bustapaga-video-unico/audio/prova.mp3
progetti/bustapaga-video-unico/audio/_prova/
progetti/bustapaga-video-unico/audio/trascrizioni/*.txt
progetti/bustapaga-video-unico/audio/esiti-testo.json
progetti/bustapaga-video-unico/audio/proposte-confini.json
progetti/bustapaga-video-unico/audio/confini.json
