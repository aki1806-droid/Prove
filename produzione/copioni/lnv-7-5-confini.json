[{"chunk": "A", "fine_di": "s02", "break_heygen": [16.693, 18.293], "taglio": 17.453, "scarto": 0.04, "coda": "onesta che si potesse promettere."}, {"chunk": "A", "fine_di": "s03", "break_heygen": [35.344, 36.944], "taglio": 36.194, "scarto": 0.05, "coda": "al posto di una conclusione."}, {"chunk": "A", "fine_di": "s04", "break_heygen": [50.944, 52.544], "taglio": 51.818, "scarto": 0.074, "coda": "parte che ti porti via."}, {"chunk": "A", "fine_di": "s05", "break_heygen": [66.955, 68.555], "taglio": 67.778, "scarto": 0.023, "coda": "il resto si e' dimenticato."}, {"chunk": "A", "fine_di": "s06", "break_heygen": [83.058, 84.658], "taglio": 83.911, "scarto": 0.053, "coda": "aggira: si puo' solo chiedere."}, {"chunk": "A", "fine_di": "s07", "break_heygen": [98.269, 99.869], "taglio": 99.074, "scarto": 0.005, "coda": "da solo, e' gia' molto."}, {"chunk": "B", "fine_di": "s09", "break_heygen": [16.96, 18.56], "taglio": 17.782, "scarto": 0.022, "coda": "non quella che resta uguale."}, {"chunk": "B", "fine_di": "s10", "break_heygen": [30.823, 32.423], "taglio": 31.646, "scarto": 0.023, "coda": "pena tornare, con una domanda."}, {"chunk": "B", "fine_di": "s11", "break_heygen": [47.623, 49.223], "taglio": 48.493, "scarto": 0.07, "coda": "persona e capire un momento."}, {"chunk": "B", "fine_di": "s12", "break_heygen": [63.036, 64.636], "taglio": 63.83, "scarto": 0.006, "coda": "ricordi una sola, ricorda questa."}, {"chunk": "B", "fine_di": "s13", "break_heygen": [80.036, 81.636], "taglio": 80.882, "scarto": 0.046, "coda": "ricostruisce, a partire da quella."}, {"chunk": "B", "fine_di": "s14", "break_heygen": [95.727, 97.327], "taglio": 96.535, "scarto": 0.008, "coda": "parte piu' facile da verificare."}, {"chunk": "B", "fine_di": "s15", "break_heygen": [113.19, 114.79], "taglio": 114.056, "scarto": 0.066, "coda": "che cosa succede, e correggere."}, {"chunk": "C", "fine_di": "s17", "break_heygen": [18.88, 20.48], "taglio": 19.682, "scarto": 0.002, "coda": "da cambiare, una alla volta."}, {"chunk": "C", "fine_di": "s18", "break_heygen": [35.623, 37.223], "taglio": 36.457, "scarto": 0.034, "coda": "ascoltato, e tu pensi meglio."}, {"chunk": "C", "fine_di": "s19", "break_heygen": [52.423, 54.023], "taglio": 53.222, "scarto": 0.001, "coda": "di guardare le tue mani."}, {"chunk": "C", "fine_di": "s20", "break_heygen": [69.326, 70.926], "taglio": 70.148, "scarto": 0.022, "coda": "parole non riescono a dire."}, {"chunk": "C", "fine_di": "s21", "break_heygen": [83.657, 85.257], "taglio": 84.501, "scarto": 0.044, "coda": "respiro, cambia anche il tono."}, {"chunk": "C", "fine_di": "s22", "break_heygen": [100.797, 102.397], "taglio": 101.593, "scarto": 0.004, "coda": "lascia le cose piu' pulite."}, {"chunk": "C", "fine_di": "s23", "break_heygen": [105.688, 107.288], "taglio": 106.55, "scarto": 0.062, "coda": "e' quello che riguarda te."}, {"chunk": "C", "fine_di": "s24", "break_heygen": [120.659, 122.259], "taglio": 121.5, "scarto": 0.041, "coda": "collaterale, e conviene saperlo prima."}, {"chunk": "C", "fine_di": "s25", "break_heygen": [135.79, 137.39], "taglio": 136.62, "scarto": 0.03, "coda": "gesto ti sembrera' un indizio."}, {"chunk": "D", "fine_di": "s27", "break_heygen": [14.24, 15.84], "taglio": 15.117, "scarto": 0.077, "coda": "ti mostra solo il controllo."}, {"chunk": "D", "fine_di": "s28", "break_heygen": [30.411, 32.011], "taglio": 31.302, "scarto": 0.091, "coda": "il piu' prevedibile del corso."}, {"chunk": "D", "fine_di": "s29", "break_heygen": [43.554, 45.154], "taglio": 44.414, "scarto": 0.06, "coda": "La differenza e' tutta li'."}, {"chunk": "D", "fine_di": "s30", "break_heygen": [49.644, 51.244], "taglio": 50.517, "scarto": 0.073, "coda": "la stai usando al contrario."}, {"chunk": "D", "fine_di": "s31", "break_heygen": [64.694, 66.294], "taglio": 65.568, "scarto": 0.074, "coda": "Una sola, non di piu'."}, {"chunk": "D", "fine_di": "s32", "break_heygen": [82.704, 84.304], "taglio": 83.554, "scarto": 0.05, "coda": "e non solo giorni diversi."}, {"chunk": "D", "fine_di": "s33", "break_heygen": [98.604, 100.204], "taglio": 99.361, "scarto": 0.043, "coda": "servira' quasi tutta a questo."}, {"chunk": "D", "fine_di": "s34", "break_heygen": [114.534, 116.134], "taglio": 115.392, "scarto": 0.058, "coda": "resto e' esercizio senza verifica."}, {"chunk": "D", "fine_di": "s35", "break_heygen": [128.064, 129.664], "taglio": 128.917, "scarto": 0.053, "coda": "si vedono il primo giorno."}, {"chunk": "E", "fine_di": "s37", "break_heygen": [14.48, 16.08], "taglio": 15.356, "scarto": 0.076, "coda": "modo in cui funziona chiunque."}, {"chunk": "E", "fine_di": "s38", "break_heygen": [30.034, 31.634], "taglio": 30.811, "scarto": 0.023, "coda": "tratti le persone che incontri."}, {"chunk": "E", "fine_di": "s39", "break_heygen": [45.017, 46.617], "taglio": 45.854, "scarto": 0.037, "coda": "tecniche passano; questa differenza resta."}, {"chunk": "E", "fine_di": "s40", "break_heygen": [60.148, 61.748], "taglio": 60.966, "scarto": 0.018, "coda": "dicono i numeri, non un'opinione."}, {"chunk": "E", "fine_di": "s41", "break_heygen": [74.479, 76.079], "taglio": 75.339, "scarto": 0.06, "coda": "fa i danni piu' grandi."}, {"chunk": "E", "fine_di": "s42", "break_heygen": [88.159, 89.759], "taglio": 89.001, "scarto": 0.042, "coda": "spettacolare, ed e' piu' utile."}, {"chunk": "E", "fine_di": "s43", "break_heygen": [93.61, 95.21], "taglio": 94.401, "scarto": 0.009, "coda": "Non e' la stessa cosa."}, {"chunk": "E", "fine_di": "s44", "break_heygen": [108.113, 109.713], "taglio": 108.895, "scarto": 0.018, "coda": "i numeri che hai sentito."}, {"chunk": "E", "fine_di": "s45", "break_heygen": [119.333, 120.933], "taglio": 120.164, "scarto": 0.031, "coda": "verifiche di chi lo usa."}, {"chunk": "E", "fine_di": "s46", "break_heygen": [134.853, 136.453], "taglio": 135.683, "scarto": 0.03, "coda": "settimana, una persona, una situazione."}, {"chunk": "E", "fine_di": "s47", "break_heygen": [150.864, 152.464], "taglio": 151.742, "s