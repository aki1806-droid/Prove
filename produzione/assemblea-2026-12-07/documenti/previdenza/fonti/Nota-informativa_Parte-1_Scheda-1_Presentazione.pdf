.perseoOrganigramma, .perseoStrutturaRow, .perseoStrutturaCol {
	display: flex;
	justify-content: center;
    align-items: center;
}

.perseoStrutturaCol {
	align-items: flex-start;
	flex-direction: column;
	gap: 30px;
}

.perseoStrutturaCol.lineaTop {
    align-self: self-start;
    padding-top: 40px;
}

.perseoBoxStruttura {
	padding: 30px;
	border-radius: 30px 0px;
}

.perseoBoxStruttura.assemblea{	background: var(--nectar-extra-color-1);}
.perseoBoxStruttura.cda{	background: var(--nectar-extra-color-2);}
.perseoBoxStruttura.cds {	background: var(--nectar-accent-color);}
.presidente {	align-self: flex-start; }
.perseoBoxStruttura.presidente {	background: var(--nectar-extra-color-3); align-self: flex-start; }

@media (max-width: 999px) {
.perseoOrganigramma {
  flex-direction: column !important;
  align-items: stretch !important;
  overflow-x: unset !important;
  justify-content: flex-start !important;
  gap: 16px;
}
.perseoOrganigramma svg {
  display: none !important;
}
.perseoOrganigramma > .perseoStrutturaCol.lineaTop {
  display: none !important;
}
.perseoOrganigramma > a,
.perseoOrganigramma > .perseoStrutturaCol {
  width: 100% !important;
}
.perseoOrganigramma > .perseoStrutturaCol {
  display: flex !important;
  flex-direction: column !important;
  gap: 16px;
}
.perseoOrganigramma > .perseoStrutturaCol > a {
  width: 100% !important;
}
	
	/*bg full*/
	/* --- Organigramma: full-width background, flush to hero, with padding --- */
@media only screen and (max-width: 999px) {
  body.page-id-165 .wpb_row.first-section {
    padding-bottom: 0 !important;
  }
  body.page-id-165 .wpb_row:has(.perseoOrganigramma) {
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    width: 100vw !important;
    max-width: 100vw !important;
    margin-top: 0 !important;
    padding-top: 40px !important;
    padding-bottom: 40px !important;
    position: relative !important;
    z-index: 2 !important;
  }
  body.page-id-165 .wpb_row:has(.perseoOrganigramma) .perseoOrganigramma {
    padding-left: 20px;
    padding-right: 20px;
  }
}
}</style><style class="wpcode-css-snippet">.perseoStruttura .column-overlay-layer {
