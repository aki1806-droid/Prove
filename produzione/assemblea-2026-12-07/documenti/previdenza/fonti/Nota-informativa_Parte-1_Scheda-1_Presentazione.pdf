      'Università',
      'Sperimentazione e ricerca',
      'EPNE - Enti pubblici non economici',
      'Ministeri',
      'Presidenza del consiglio dei ministri (solo dirigenti)',
      'Agenzia fiscale o ente convenzionato MEF',
      'Polizia locale'
    ],
    'Privato': [
      'Dipendenti Organizzazioni sindacali (Perseo Sirio)',
      'FICEI',
      'UNIONCAMERE',
      'Case di cura e di riposo',
      'Agenzie del demanio',
      'Sport e salute',
      'Federazioni sportive'
    ]
  };

  var PH_VUOTO = '-- Prima seleziona una categoria --';
  var PH_ENTE  = '-- Seleziona il tuo ente --';

  function init() {
    document.querySelectorAll('.cf7-custom-form').forEach(function (wrap) {
      var cat  = wrap.querySelector('select[name="categoria"]');
      var ente = wrap.querySelector('select[name="ente"]');
      if (!cat || !ente) return;

      function popolaEnti() {
        var lista = ENTI[cat.value] || [];
        ente.innerHTML = '';
        ente.add(new Option(lista.length ? PH_ENTE : PH_VUOTO, ''));
        lista.forEach(function (v) {
          ente.add(new Option(v, v));
        });
        ente.disabled = !lista.length;
      }

      cat.addEventListener('change', popolaEnti);

      // CF7 fa form.reset() dopo l'invio: riallinea il secondo select
      var form = wrap.closest('form');
      if (form) {
        form.addEventListener('reset', function () {
          setTimeout(popolaEnti, 0);
        });
      }

      popolaEnti();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();</script><style class="wpcode-css-snippet">/* Targhetta data evento */
