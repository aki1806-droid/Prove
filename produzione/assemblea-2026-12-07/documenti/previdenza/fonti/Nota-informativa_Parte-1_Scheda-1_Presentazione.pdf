  color: #FFF !important;
  text-decoration: none !important;
  pointer-events: none !important;
}</style><script>(function () {
  var RATIO = 9 / 16;

  function fix() {
    document.querySelectorAll('.nectar-post-grid-wrap').forEach(function (wrap) {
      if (!/PerseoCard/.test(wrap.className)) return;
      var grid = wrap.querySelector('.nectar-post-grid[data-columns="1"]');
      if (!grid) return;
      var item = grid.querySelector('.nectar-post-grid-item');
      if (!item) return;
      var w = item.offsetWidth;
      if (!w) return;
      var h = Math.round(w * RATIO);

      // Item
      item.style.setProperty('height', h + 'px', 'important');
      item.style.setProperty('overflow', 'hidden', 'important');

      // .inner — riempie il container
      var inner = item.querySelector('.inner');
      if (inner) {
        inner.style.setProperty('position', 'absolute', 'important');
        inner.style.setProperty('top', '0', 'important');
        inner.style.setProperty('left', '0', 'important');
        inner.style.setProperty('right', '0', 'important');
        inner.style.setProperty('bottom', '0', 'important');
        inner.style.setProperty('height', h + 'px', 'important');
        inner.style.setProperty('overflow', 'hidden', 'important');
      }

      // .nectar-post-grid-item-bg-wrap — Salient lo mette a 300px, lo correggiamo
      var bgWrap = item.querySelector('.nectar-post-grid-item-bg-wrap');
      if (bgWrap) {
        bgWrap.style.setProperty('height', h + 'px', 'important');
        bgWrap.style.setProperty('overflow', 'hidden', 'important');
      }

      // .nectar-post-grid-item-bg — il div che contiene l'img
      var bg = item.querySelector('.nectar-post-grid-item-bg');
      if (bg) {
        bg.style.setProperty('height', h + 'px', 'important');
      }

      // img — object-position a sinistra
      var img = item.querySelector('img');
      if (img) {
        img.style.setProperty('width', w + 'px', 'important');
        img.style.setProperty('height', h + 'px', 'important');
        img.style.setProperty('object-fit', 'cover', 'important');
        img.style.setProperty('object-position', 'left center', 'important');
      }
    });
  }

  // Osserva cambiamenti e ri-applica sempre
  function init() {
    fix();
    [200, 500, 1000, 2000].forEach(function (t) { setTimeout(fix, t); });
    window.addEventListener('resize', fix);
    var obs = new MutationObserver(function () { fix(); });
    var target = document.querySelector('.nectar-post-grid-wrap[class*="PerseoCard"]');
    if (target) obs.observe(target, { attributes: true, subtree: true, attributeFilter: ['style'] });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();</script><style class="wpcode-css-snippet">.perseo-h2-as-h1 {
	font-size: 65px;
