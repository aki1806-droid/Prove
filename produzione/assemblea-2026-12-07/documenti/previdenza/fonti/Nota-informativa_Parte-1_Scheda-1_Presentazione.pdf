.perseoSelettoreBG .tab-item.active-tab span {    color: var(--wp--preset--color--white);    }

/* Carosello comparti */
.perseoCompartiRow .dot:before { opacity: 0.5; }

.perseoCompartiRow .dot.is-selected:before { opacity: 1; }

.perseoCompartiRow .dot:before, .perseoCompartiRow .dot.is-selected:before {
