}</style><style class="wpcode-css-snippet">/*Toggle*/



.perseoToggle .toggle .toggle-title, 
.columnTogglePerseo .toggle .toggle-title {
    border-radius: 20px 0 !important;
    overflow: hidden;
	background: #E6ECF1!important;
	margin-bottom: 0px !important;
	box-shadow: 0 4px 10px rgba(0,0,0,0.2);
	border-radius: 30px;
}

.perseoToggle .toggle h3 a,
.columnTogglePerseo .toggle h3 a
{
    background: transparent !important;
    font-size: 25px !important;
    line-height: 25px !important;
	font-weight: 400 !important;
    padding: 20px 70px 20px 60px;
	line-height: 1.2 !important;
}

.perseoToggle .toggle h3 a, .toggle-y .toggle.open h3 a,
.columnTogglePerseo .toggle h3 a 
{
    color: var(--nectar-ectra-color-1) !important;
}

.perseoToggle .toggle h3 a:after, .toggle-y .toggle h3 a:after,
.columnTogglePerseo .toggle h3 a:after
{
    content: "";
    width: 30px;
    height: 30px;
    display: block;
    position: absolute;
    right: 30px;
    top: calc(50% - 15px);
    background: url(/wp-content/uploads/2026/06/arrow-perseosirio.svg) !important;
    background-size: contain !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    transition: all 0.2s ease-in;
}


.perseoToggle .toggle h3 a:before, .toggle-y .toggle h3 a:before,
.columnTogglePerseo .toggle h3 a:before
{
    content: "";
    width: 20px;
    height: 20px;
    display: block;
    position: absolute;
    left: 10px;
    top: calc(50% - 10px);
    background: url(/wp-content/uploads/2026/02/tondo-perseo-sirio.svg) !important;
    background-size: contain !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    transition: all 0.2s ease-in;
}

.perseoToggle .toggle.open h3 a:after, .toggle-y .toggle.open h3 a:after,
.columnTogglePerseo .toggle.open h3 a:after
{
	content: "";
    width: 30px;
    height: 30px;
    display: block;
    position: absolute;
    right: 30px;
    top: calc(50% - 15px);
    background: url(/wp-content/uploads/2026/06/arrow-perseosirio.svg) !important;
    background-size: contain !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
	transform: rotate(180deg);
	transition: all 0.2s ease-in;
}

.perseoToggle .toggle>.toggle-title a i,
.columnTogglePerseo .toggle>.toggle-title a i
{
    display: none !important;
}

.perseoToggle .toggle>div,
.columnTogglePerseo .toggle>div
{
	box-shadow: unset !important;
	height: 0 !important;
	max-height: unset !important;
	transition: height 0.5s ease-in;
	background-color: transparent !important;
}

.perseoToggle .toggle.open>div, 
.columnTogglePerseo .toggle.open>div
{
	max-height: unset;
	height: auto !important;
	transition: height 0.5s ease-in;
}

.perseoToggle .toggle.open div.inner-toggle-wrap,
