/* Nasconde l'immagine di sfondo */
.eventi-grid .nectar-post-grid-item .nectar-post-grid-item-bg-wrap {
  display: none !important;
}

/* Card: sfondo chiaro, niente overlay */
.eventi-grid .nectar-post-grid-item {
  background-color: #E6ECF1 !important;
  border-radius: 28px !important;
  overflow: hidden;
}

/* Rimuove overlay scuro */
.eventi-grid .nectar-post-grid-item .bg-overlay {
  display: none !important;
}

/* Card non cliccabili */
.eventi-grid .nectar-post-grid-item a {
  pointer-events: none !important;
  cursor: default !important;
}

/* Contenuto centrato verticalmente */
.eventi-grid .nectar-post-grid-item .inner {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* Padding interno */
.eventi-grid .nectar-post-grid-item .overlaid-content {
  position: relative !important;
  padding: 24px !important;
  padding-bottom: 0 !important;
  transform: none !important;
  top: auto !important;
  left: auto !important;
  width: 100%;
  text-align: center !important;
}

/* Forza allineamento centrato su tutti gli elementi testo */
.eventi-grid .nectar-post-grid-item .overlaid-content *,
.eventi-grid .nectar-post-grid-item .post-title,
.eventi-grid .nectar-post-grid-item .excerpt-content p,
.eventi-grid .nectar-post-grid-item .excerpt-content {
  text-align: center !important;
}

/* Tag categoria — stile pill */
.eventi-grid .nectar-post-grid-item .meta-category {
  text-align: center !important;
}

.eventi-grid .nectar-post-grid-item .meta-category a {
  display: inline-block;
  border: 1px solid #013759;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  margin-bottom: 12px;
  color: #ffffff !important;
  background-color: #013759;
}

/* Titolo */
.eventi-grid .nectar-post-grid-item .post-title {
  font-size: 18px !important;
  font-weight: 600 !important;
  line-height: 1.3 !important;
  color: #013759 !important;
}

/* Excerpt */
.eventi-grid .nectar-post-grid-item .excerpt-content {
  color: #013759 !important;
  margin-bottom: 0 !important;
}

.eventi-grid .nectar-post-grid-item .excerpt-content p {
  margin-bottom: 0 !important;
}
</style><script>window.addEventListener('load', function() {
