}</style><style class="wpcode-css-snippet">.perseoFlexButton{
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}

.perseoBottone.big, .perseoSubmenu ul > li.menu-item a {
	display: inline-flex;
	padding: 10px 15px;
	justify-content: center;
	align-items: center;
	gap: 10px;
	border-radius: 15px 0;
	text-align: center;
	font-family: "Bebas Neue";
	font-size: 20px;
	font-style: normal;
	font-weight: 400;
	line-height: normal;
	text-transform: uppercase;
}

.perseoBottone.full, .perseoSubmenu ul > li.menu-item a {
	width: 100%;
}

.perseoBottone.blu {
	background: var(--nectar-accent-color);
	color: var(--nectar-bg-color);
	transition: 0.3s;
}

.perseoBottone.blu:hover {
	background: var(--nectar-extra-color-1);
	color: var(--nectar-bg-color);
}

.perseoBottone.blu.outline {
	background: transparent;
	color: var(--nectar-accent-color);
	border: 2px solid var(--nectar-accent-color);
	transition: 0.3s;
}
.perseoBottone.blu.outline:hover {
	background: var(--nectar-accent-color);
	color: var(--nectar-bg-color);
}

.perseoBottone.white {
	background: var(--nectar-bg-color);
	color: var(--nectar-accent-color);
	transition: 0.3s;
	border: 2px solid var(--nectar-bg-color);
}

.perseoBottone.white:hover {
	background: transparent;
	color: var(--nectar-bg-color);
	border: 2px solid var(--nectar-bg-color);
}

.perseoBottone.white.outline{
	background: transparent;
	color: var(--nectar-bg-color);
	transition: 0.3s;
	border: 2px solid var(--nectar-bg-color);
}

.perseoBottone.white.outline:hover {
	background: var(--nectar-bg-color);
	color: var(--nectar-accent-color);
	border: 2px solid var(--nectar-bg-color);
}

.perseoBottone.green {
	background: var(--nectar-extra-color-2);
	color: var(--nectar-font-color);
	transition: 0.3s;
}

.perseoBottone.green:hover {
	background: var(--nectar-bg-color);
}

.perseoBottone.transparent, 
.perseoSubmenu ul > li.menu-item a{
	color: var(--nectar-accent-color);
	border: 1px solid var(--nectar-accent-color);
	transition: 0.3s;
	margin-bottom:5px!important;
}

.perseoBottone.transparent {
	background: transparent;
}

.perseoSubmenu ul > li.menu-item a {
	background: var(--nectar-font-light-color);
}

.perseoBottone.transparent:hover, .perseoBottone.transparent.voceSidebarAttiva,
.perseoSubmenu ul > li.menu-item a:hover, 
.perseoSubmenu ul > li.menu-item.active a {
	background: var(--nectar-accent-color);
	color: var(--nectar-bg-color);
}


@media only screen and (max-width: 999px){
	.perseoSubmenu.vertical ul > li.menu-item a:hover, 
	.perseoSubmenu.vertical ul > li.menu-item.active a {
		color: var(--nectar-accent-color);
		background: var(--nectar-font-light-color);
	}
}</style><style class="wpcode-css-snippet">/* gestione riga con tutte le voci del menu */
@media only screen and (min-width: 1000px) {
    #header-outer:not([data-format=left-header]) #top>.container>.row nav {
        justify-content: end !important;
    }
}

#top > .container > .row {	gap: 30px;}

#header-outer[data-format=centered-menu] #top .span_9 .sf-menu:not(.buttons) {
    width: 80%;
}

/* gestione voce menu "FAQ" e "News e Media" */
ul.sf-menu.sf-js-enabled.sf-arrows {
  display: grid !important;
  list-style: none;
  padding: 0;
  margin: 0;
  grid-template-areas:
    "first	.	.	.	faq  news"
    "chi  perche prestazioni finanza doc   admin";
  grid-template-rows: auto auto;
  grid-template-columns: repeat(6, auto);
  gap: 0px 25px; 
  justify-content: start;
	justify-items: end;
}

ul.sf-menu.sf-js-enabled.sf-arrows::after {
	content: '';
	grid-row: 1;
	grid-column: first-start / news-end;
	align-self: end;
	height: 1px;
	width: 100%;
	background-color: #fff;
}

/* Assegniamo ogni <li> del menù la sua area definita in grid-template-areas */
/* --- Prima riga --- */
#menu-item-22 { grid-area: faq; }
#menu-item-1911 { grid-area: news; }

/* --- Seconda riga --- */
#menu-item-12 { grid-area: chi; }
#menu-item-13 { grid-area: perche; }
#menu-item-14 { grid-area: prestazioni; }
#menu-item-15 { grid-area: finanza; }
#menu-item-16 { grid-area: doc; }
#menu-item-17 { grid-area: admin; }

/* togliere spazio per bottone in absolute*/
.logo-spacing {	display: none;}

ul.buttons.sf-menu {	
	position: static !important;
    flex-wrap: nowrap !important;
}

/* bottone Accedi */
#top nav > ul.buttons li.menu-item a {
    background-color: var(--nectar-extra-color-2);
	border-radius: 15px 0;
	padding: 8px 15px 8px 15px !important;
	transition: 0.3s;
}

#top nav > ul.buttons li.menu-item a:hover {
    background-color: #91be55;
}

#top nav > ul.buttons a span {
	color: var(--nectar-font-color);
	font-family: 'Red Hat Display';
	text-transform: uppercase;
	font-weight: 700;
	font-size: 12px;
	letter-spacing: 0.5px;
}</style><link rel="icon" href="https://www.fondoperseosirio.it/wp-content/uploads/2026/04/fav-perseo-sirio-100x100.png" sizes="32x32" />
