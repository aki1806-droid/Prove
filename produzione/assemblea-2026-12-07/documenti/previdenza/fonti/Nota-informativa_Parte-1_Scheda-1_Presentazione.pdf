</style><script>jQuery(document).ready(function($) {
    // Preleva tutti i tag <a> con classi "perseoBottone" e "transparent" figli di "sidebarPerseo"
    $('.sidebarPerseo a.perseoBottone.transparent').each(function() {
        var hrefValue = $(this).attr('href');

        if (hrefValue) {
            // Rimuove tutto ciò che è dopo il carattere '#'
            var hrefClean = hrefValue.split('#')[0];

            // Controlla se l'href pulito è contenuto nell'URL della pagina attuale
            if (hrefClean && window.location.href.indexOf(hrefClean) !== -1) {
                $(this).addClass('voceSidebarAttiva');
            }
        }
		
		if (window.innerWidth <= 999) {
			var $voceAttiva = $('.sidebarPerseo a.voceSidebarAttiva').first();
			if ($voceAttiva.length) {
				var $wrapper = $('.sidebarPerseo .bottoniSidebar > div');
				var offsetSinistraWrapper = $wrapper.offset().left;
				var offsetSinistraVoce = $voceAttiva.offset().left;
				var scrollTarget = $wrapper.scrollLeft() + (offsetSinistraVoce - offsetSinistraWrapper);

				$wrapper.animate({ scrollLeft: scrollTarget }, 400);
			}
    	}
    });
});

</script><style class="wpcode-css-snippet">div#copyright {
    display: none;
}</style><script>jQuery(document).ready(function($) {
    var $nav = $('.scrolling-tab-nav');
	if($nav && $nav.offset()){
		var offsetTop = $nav.offset().top;

		$(window).on('scroll', function() {
			if ($(window).scrollTop() >= offsetTop) {
				$nav.addClass('is-sticky');
			} else {
				$nav.removeClass('is-sticky');
			}
		});
	}
});</script><style class="wpcode-css-snippet">.gestioneFinanziaria_Box .vc_column-inner {
