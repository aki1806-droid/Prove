</style><style class="wpcode-css-snippet">/*No tremolio*/
.perseoSubmenu.vertical .scrolling-tab-nav .theiaStickySidebar {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;}

.perseoSubmenu.vertical .scrolling-tab-nav ul.wpb_tabs_nav.ui-tabs-nav {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;}




.perseoSubmenu .nectar-scrolling-tabs.initalized {
    flex-direction: row-reverse;
}


.nectar-scrolling-tabs .scrolling-tab-nav .theiaStickySidebar:before {	display: none !important; }

.perseoSubmenu .line {	display: none !important; }

@media (min-width: 1000px) {
.perseoSubmenu ul.wpb_tabs_nav.ui-tabs-nav{
	padding: 0 10%;
}

/*background bianco*/
.perseoSubmenu.vertical .nectar-scrolling-tabs ul.wpb_tabs_nav.ui-tabs-nav {
    background-color: rgba(255, 255, 255, 0.6) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    padding: 10px !important;
    border-radius: 15px 0px !important;
    width: fit-content !important;
  }
	}

.perseoSubmenu li.menu-item{
	padding-bottom: 5px !important;
	padding-left: 0 !important;
	opacity: 1 !important;
}

/* submenu verticale */
.perseoSubmenu.vertical .nectar-scrolling-tabs {
    flex-direction: column;
	width: 100% !important;
}

.perseoSubmenu.vertical .nectar-scrolling-tabs .scrolling-tab-nav {
    flex-direction: column;
	width: 100% !important;
	z-index: 2;
	margin-bottom: 30px;
}

@media only screen and (max-width: 999px) {
    .nectar-scrolling-tabs:not(.navigation_func_active_link_only) .scrolling-tab-nav {
        display: block !important;
    }
	
	.scrolling-tab-nav.is-sticky {
    	position: fixed;
        top: 130px;
        left: 0;
        padding: 0 5%;
		z-index: 10;
	}
	
	.scrolling-tab-nav ul {
    	flex-wrap: wrap;
	}
	
	.scrolling-tab-nav ul li {
    	padding-bottom: 0 !important;
	}
}

.perseoSubmenu.vertical .nectar-scrolling-tabs .scrolling-tab-content {
	z-index: 1;
	padding-left: 0 !important;
	position: relative;

}

.perseoSubmenu.vertical .nectar-scrolling-tabs .wpb_tabs_nav{
	display: flex;
	gap: 10px;
	padding: 0 !important;
}

/*mobile*/
@media only screen and (max-width: 999px) {
	
  .perseoSubmenu .scrolling-tab-nav.is-sticky {
  position: relative !important;
  top: auto !important;
  left: auto !important;
  z-index: auto !important;
  padding: 0 !important;
}
	
  .perseoSubmenu .scrolling-tab-nav {
    width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch;
  }
  .perseoSubmenu ul.wpb_tabs_nav {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .perseoSubmenu ul.wpb_tabs_nav li.menu-item {
    flex: 0 0 auto !important;
    width: auto !important;
    float: none !important;
  }
  .perseoSubmenu ul.wpb_tabs_nav li .tab-nav-heading {
    white-space: nowrap;
  }
}

/* === SOLO pagina Gli Organi del Fondo (page-id-165) === */
@media only screen and (max-width: 999px) {
  body.page-id-165 .perseoSubmenu,
  body.page-id-165 .perseoSubmenu .scrolling-tab-nav,
  body.page-id-165 .perseoSubmenu .n-sticky,
  body.page-id-165 .perseoSubmenu .theiaStickySidebar {
    position: static !important;
    top: auto !important;
    z-index: auto !important;
  }

	/*organi del fondo + faq*/
body.page-id-165 .perseoSubmenu .scrolling-tab-nav, body.page-id-1189 .perseoSubmenu .scrolling-tab-nav  {
  margin-bottom: 30px !important;
}
  body.page-id-165 .perseoSubmenu .n-sticky {
    width: 100%;
  }
  body.page-id-165 .perseoSubmenu ul.wpb_tabs_nav,   body.page-id-1189 .perseoSubmenu ul.wpb_tabs_nav {
    padding-left: 0 !important;
