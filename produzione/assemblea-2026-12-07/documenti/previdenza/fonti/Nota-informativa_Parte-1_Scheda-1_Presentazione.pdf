}</style><style class="wpcode-css-snippet">.PerseoCard .body[data-button-style^=rounded] .nectar-post-grid-filters h4, body[data-button-style^=rounded] .nectar-post-grid-wrap .load-more, body[data-button-style^=rounded] .nectar-post-grid-wrap .load-more:before {
    margin-top: 5%;
}</style><style class="wpcode-css-snippet">  /* ============================================================
     Fix banner cookie GDPR
     ------------------------------------------------------------
     STORICO: le regole sotto erano per il vecchio banner a barra
     (posizione bottom + z-index sopra l'header Salient, che ha 9999).
     Con la modalità Full-screen / Cookiewall dell'addon premium
     questo z-index 999999 finiva SOPRA il modal impostazioni
     (.gdpr_lightbox, z-index 9990) e lo rendeva inutilizzabile.
     Le lascio commentate per riferimento: da eliminare quando
     la nuova configurazione è confermata.
     ============================================================ */

  /* --- VECCHIE REGOLE (disattivate) -------------------------- */
  /*
  #moove_gdpr_cookie_info_bar {
      position: fixed !important;
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      z-index: 999999 !important;
  }

  body.moove_gdpr_overflow #moove_gdpr_cookie_info_bar {
      z-index: 999999 !important;
  }

  @media (max-width: 767px) {
      #moove_gdpr_cookie_info_bar {
          position: fixed !important;
          bottom: 0 !important;
          top: auto !important;
          z-index: 999999 !important;
      }
  }
  */

  /* --- NUOVE REGOLE (cookiewall full-screen) ----------------- */

  /* Cookiewall: sopra l'header Salient (#header-outer, z-index 9999)
     ma sotto il modal impostazioni. Il secondo selettore serve a
     battere in specificità la vecchia regola body.moove_gdpr_overflow. */
  #moove_gdpr_cookie_info_bar.gdpr-full-screen-infobar,
  body.moove_gdpr_overflow #moove_gdpr_cookie_info_bar.gdpr-full-screen-infobar {
      z-index: 99999 !important;
      top: 0 !important;
  }

  /* Modal impostazioni (lightbox del plugin): deve stare sopra il cookiewall.
     Attivo solo mentre il modal è aperto (body.moove_gdpr_overflow). */
  body.moove_gdpr_overflow .gdpr_lightbox,
  body.moove_gdpr_overflow .gdpr_lightbox-wrap {
      z-index: 100000 !important;
  }</style><script>document.addEventListener('DOMContentLoaded', initPerseoSelects);
document.addEventListener('wpcf7:mounted', initPerseoSelects);

function initPerseoSelects() {
  mirrorOptions('#filtro-categoria', '#select-categoria-cf7', true);
  mirrorOptions('#filtro-ente', '#select-ente-cf7', true);

  observeAndMirror('#filtro-ente', '#select-ente-cf7');

  bindExternalToCf7('#filtro-categoria', '#select-categoria-cf7');
  bindExternalToCf7('#filtro-ente', '#select-ente-cf7');

  bindCf7ToExternal('#select-categoria-cf7', '#filtro-categoria');
  bindCf7ToExternal('#select-ente-cf7', '#filtro-ente');
}

// syncValue = true copia anche il valore correntemente selezionato nella source
function mirrorOptions(sourceSelector, targetSelector, syncValue) {
  var source = document.querySelector(sourceSelector);
  var target = document.querySelector(targetSelector);
  if (!source || !target) return;

  var valueToKeep = syncValue ? source.value : target.value;
  target.innerHTML = source.innerHTML;

  if (Array.from(target.options).some(function (o) { return o.value === valueToKeep; })) {
    target.value = valueToKeep;
  }
}

function observeAndMirror(sourceSelector, targetSelector) {
  var source = document.querySelector(sourceSelector);
  if (!source) return;

  var observer = new MutationObserver(function () {
    mirrorOptions(sourceSelector, targetSelector, true);
  });
  observer.observe(source, { childList: true });
}

// Select esterna cambiata (dall'utente o da altro script) → aggiorna la select CF7
function bindExternalToCf7(externalSelector, cf7Selector) {
  var external = document.querySelector(externalSelector);
  if (!external) return;

  external.addEventListener('change', function () {
    var cf7Select = document.querySelector(cf7Selector);
    if (!cf7Select || cf7Select.dataset.syncing === '1') return;
    if (cf7Select.value === external.value) return;

    cf7Select.dataset.syncing = '1';
    cf7Select.value = external.value;
    cf7Select.dataset.syncing = '0';
  });
}

// Select CF7 cambiata dall'utente → rilancia il cambiamento sulla select esterna
function bindCf7ToExternal(cf7Selector, externalSelector) {
  var cf7Select = document.querySelector(cf7Selector);
  if (!cf7Select) return;

  cf7Select.addEventListener('change', function () {
    if (cf7Select.dataset.syncing === '1') return;

    var external = document.querySelector(externalSelector);
    if (!external || external.value === cf7Select.value) return;

    external.value = cf7Select.value;
    external.dispatchEvent(new Event('change'));
  });
}</script><style class="wpcode-css-snippet">.perseo-field {
