          <path d="M13.7295 21C13.5537 21.3031 13.3014 21.5547 12.9978 21.7295C12.6941 21.9044 12.3499 21.9965 11.9995 21.9965C11.6492 21.9965 11.3049 21.9044 11.0013 21.7295C10.6977 21.5547 10.4453 21.3031 10.2695 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="pfs-pulse"></span>
      </div>
      <div id="pfs-toast" class="pfs-toast" role="status">
        <div class="pfs-toast-inner">
          <div class="pfs-toast-text">
            <!-- MODIFICA QUI IL TESTO -->
            <h3 class="pfs-toast-title">I moduli devono essere compilati <span class="pfs-toast-accent">esclusivamente online/in formato digitale</span> e inviati via PEC a <a href="mailto:adesioni@pec.perseosirio.it" class="pfs-toast-mail">adesioni@pec.perseosirio.it</a></h3>
          </div>
                    <a id="pfs-toast-link" class="pfs-toast-btn is-off" aria-hidden="true" tabindex="-1" hidden>
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <button id="pfs-toast-close" class="pfs-toast-x" aria-label="Chiudi">&times;</button>
        </div>
      </div>
    </div>

    <style>
    .pfs-wrap{position:fixed;right:24px;bottom:80px;
      display:flex;align-items:center;z-index:400;}

    .pfs-bubble{flex-shrink:0;width:74px;height:74px;border-radius:50%;
      background:var(--nectar-accent-color);color:#ffffff;cursor:pointer;
      display:flex;align-items:center;justify-content:center;position:relative;
      transition:transform .35s ease, opacity .35s ease;}
    .pfs-bubble.is-hidden{opacity:0;transform:scale(0);}
    .pfs-pulse{position:absolute;inset:0;border-radius:50%;
      border:2px solid var(--nectar-accent-color);animation:pfs-pulse 2s ease-out infinite;}
    @keyframes pfs-pulse{0%{transform:scale(1);opacity:.8}100%{transform:scale(1.8);opacity:0}}

    .pfs-toast{max-width:0;opacity:0;margin-right:0;overflow:hidden;white-space:nowrap;
      order:-1;
      transition:max-width .45s cubic-bezier(.2,.9,.3,1.1), opacity .3s ease .05s, margin-right .45s ease;}
    .pfs-toast.is-open{max-width:430px;opacity:1;margin-right:16px;}
    .pfs-toast.is-open-done{overflow:visible;}

    .pfs-toast-inner{width:390px;max-width:90vw;background:#E6ECF1;border-radius:10px;
      border:0.5px solid rgba(0,0,0,.18);
      box-shadow:0 18px 44px rgba(0,0,0,.24), 0 6px 18px rgba(0,0,0,.14);
      padding:18px 20px;display:flex;align-items:center;gap:12px;white-space:normal;
      box-sizing:border-box;}

    .pfs-toast-text{flex:1;height:auto;display:flex;flex-direction:column;
      justify-content:center;align-self:center;overflow:visible;}
    .pfs-toast-title{margin:0 !important;padding:0 !important;
      font-family:'Bebas Neue',sans-serif !important;font-size:19px !important;
      line-height:1.15 !important;letter-spacing:.02em;
      color:var(--nectar-accent-color);font-weight:400 !important;}
    .pfs-toast-title .pfs-toast-accent{color:#D62828 !important;}
    .pfs-toast-title .pfs-toast-mail{color:var(--nectar-extra-color-1) !important;}

    .pfs-toast-btn{width:42px;height:42px;border-radius:50%;flex-shrink:0;align-self:center;
      background:rgba(255,255,255,.6);color:var(--nectar-accent-color);
      display:flex;align-items:center;justify-content:center;}
    .pfs-toast-btn.is-off{display:none !important;} /* link disattivato: si controlla da $link_active nel PHP */

    .pfs-toast-x{width:26px;height:26px;border:none;background:transparent;flex-shrink:0;align-self:center;
      color:var(--nectar-accent-color);opacity:.6;font-size:19px;cursor:pointer;
      display:flex;align-items:center;justify-content:center;line-height:1;padding:0;}

    .pfs-bubble svg,
    .pfs-toast-btn svg{display:block;}

    /* Gradiente: esce di 160px sotto lo schermo (parte piena di blu) così copre anche
       l'area dietro la barra del browser su iPhone. Sopra si dissolve per 340px. */
    .pfs-glow{display:none;position:fixed;left:0;right:0;bottom:-160px;height:0;
      background:linear-gradient(to top,
        var(--nectar-accent-color) 0,
        var(--nectar-accent-color) 160px,
        transparent 100%);
      pointer-events:none;z-index:399;opacity:1;transition:opacity .4s ease;}
    .pfs-glow.is-hidden{opacity:0;}

    /* === MOBILE: bolla sopra, toast sotto, tutto centrato in basso === */
    @media (max-width: 640px){
      .pfs-glow{display:block;height:500px;} /* 160px di estensione sotto lo schermo + 340px di dissolvenza visibile */
      .pfs-wrap{
        flex-direction:column;
        left:50%;right:auto;
        transform:translateX(-50%);
      }
      .pfs-bubble{width:60px;height:60px;}
      .pfs-bubble svg{width:24px;height:24px;}
      .pfs-toast{
        order:1;
        max-width:none;width:auto;
        max-height:0;opacity:0;
        margin-right:0;margin-top:0;
        transition:max-height .45s cubic-bezier(.2,.9,.3,1.1), opacity .3s ease .05s, margin-top .45s ease;
      }
      .pfs-toast.is-open{
        max-height:220px;opacity:1;margin-top:12px;
      }
      .pfs-toast-inner{width:78vw;max-width:300px;padding:14px 16px;gap:10px;}
      .pfs-toast-title{font-size:16px !important;}
      .pfs-toast-btn{width:36px;height:36px;}
      .pfs-toast-btn svg{width:18px;height:18px;}
      .pfs-toast-x{width:22px;height:22px;font-size:16px;}
    }
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
      var wrap   = document.querySelector('.pfs-wrap');
      var bubble = document.getElementById('pfs-bubble');
      var toast  = document.getElementById('pfs-toast');
      var glow   = document.querySelector('.pfs-glow');
      var closeBtn = document.getElementById('pfs-toast-close');
      var linkBtn  = document.getElementById('pfs-toast-link');
      var autoCloseTimer;

      // Se l'utente ha già chiuso l'avviso con la X in questa sessione, non mostrare nulla
      if (sessionStorage.getItem('pfsAlertDismissed') === '1') {
        wrap.style.display = 'none';
        glow.style.display = 'none';
        return;
      }

      function openToast() {
        clearTimeout(autoCloseTimer);
        glow.classList.remove('is-hidden');
        toast.classList.add('is-open');
        setTimeout(function(){ toast.classList.add('is-open-done'); }, 470);
        autoCloseTimer = setTimeout(function(){ closeToast(false); }, 40000); // 40s
      }

      function closeToast(dismissForSession) {
        clearTimeout(autoCloseTimer);
        toast.classList.remove('is-open-done');
        toast.classList.remove('is-open');

        if (dismissForSession) {
          // Chiusura con la X: sparisce del tutto, come un cookie banner,
          // e non ricompare finché non finisce la sessione del browser
          sessionStorage.setItem('pfsAlertDismissed', '1');
          setTimeout(function(){
            bubble.classList.add('is-hidden');
            glow.classList.add('is-hidden');
          }, 300);
        } else if (window.matchMedia('(max-width: 640px)').matches) {
          // Chiusura automatica dopo 40s su mobile: solo il gradiente sparisce,
          // la bolla resta visibile e cliccabile
          glow.classList.add('is-hidden');
        }
      }

      setTimeout(openToast, 1500);

      closeBtn.addEventListener('click', function(){ closeToast(true); });
      linkBtn.addEventListener('click', function(){ closeToast(false); });

      // Chiusura automatica (40s): la bolla resta e diventa cliccabile per riaprire il toast
      bubble.addEventListener('click', function(){
        if (!toast.classList.contains('is-open')) {
          openToast();
        }
      });
      bubble.addEventListener('keydown', function(e){
        if ((e.key === 'Enter' || e.key === ' ') && !toast.classList.contains('is-open')) {
          e.preventDefault();
          openToast();
        }
      });

      // === Posiziona l'alert dinamicamente subito sopra al banner cookie ===
      // MODIFICA QUI il selettore se il tuo banner cookie usa un altro ID/classe
      var COOKIE_BAR_SELECTOR = '#moove_gdpr_cookie_info_bar, .moove-gdpr-info-bar-container';
      var GAP_ABOVE_BAR = 16; // spazio tra il banner cookie e l'alert
      var FALLBACK_BOTTOM = 80; // usato quando il banner cookie non è presente/visibile

      function repositionAboveCookieBar() {
        var bar = document.querySelector(COOKIE_BAR_SELECTOR);
        var isVisible = bar && bar.offsetHeight > 0 &&
          window.getComputedStyle(bar).display !== 'none' &&
          window.getComputedStyle(bar).visibility !== 'hidden';

        if (isVisible) {
          var barHeight = bar.getBoundingClientRect().height;
          wrap.style.bottom = (barHeight + GAP_ABOVE_BAR) + 'px';
        } else {
          wrap.style.bottom = FALLBACK_BOTTOM + 'px';
        }
      }

      repositionAboveCookieBar();
      window.addEventListener('resize', repositionAboveCookieBar);

      // Il banner cookie in genere scompare (o cambia altezza) dopo il click su "Accetta":
      // un MutationObserver intercetta quel cambiamento e riposiziona subito l'alert
      var cookieObserver = new MutationObserver(repositionAboveCookieBar);
      cookieObserver.observe(document.body, { childList: true, subtree: true, attributes: true });
    });
    </script>

    	<!--copyscapeskip-->
