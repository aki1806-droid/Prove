# Token generato da AnyChat: Settings -> API settings.
# Questo file e' un modello: il token vero va in .env, che e' gitignorato.
ANYCHAT_API_TOKEN=

# Base URL dell'API. Da confermare con la documentazione AnyChat.
ANYCHAT_BASE_URL=https://api.anychat.one

# Come viaggia il token: bearer | header | query
# bearer -> Authorization: Bearer <token>
# header -> <ANYCHAT_AUTH_NAME>: <token>
# query  -> ?<ANYCHAT_AUTH_NAME>=<token>
ANYCHAT_AUTH_STYLE=bearer
ANYCHAT_AUTH_NAME=Authorization

# Prefisso internazionale applicato ai numeri scritti in forma nazionale
# (es. 39 per l'Italia). Senza, i numeri nazionali vengono scartati invece
# che attribuiti al paese sbagliato.
ANYCHAT_DEFAULT_COUNTRY_CODE=

# Limiti di invio. Vanno allineati al tier assegnato da Meta al tuo numero:
# superarlo fa sospendere il numero.
ANYCHAT_MESSAGES_PER_SECOND=5
ANYCHAT_DAILY_CAP=1000

# Path di invio dei template. Vuoto finche' non e' confermato: senza questo
# anychat_send_broadcast rifiuta di inviare.
ANYCHAT_SEND_PATH=

# stdio (per Claude Desktop / Claude Code) oppure http (server remoto)
ANYCHAT_MCP_TRANSPORT=stdio

# Dove vivono contatore giornaliero e registro degli invii. Il registro e' cio'
# che impedisce di riscrivere a chi ha gia' ricevuto quando si rilancia.
# ANYCHAT_STATE_PATH=~/.anychat-mcp/state.json
# ANYCHAT_LOG_PATH=~/.anychat-mcp/sendlog.jsonl
