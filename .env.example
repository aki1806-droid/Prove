# --- WhatsApp Cloud API (pannello Meta for Developers) ---

# Stringa che scegli tu: Meta te la rimanda nell'handshake del webhook e
# la confrontiamo per accettare la configurazione dell'URL.
WHATSAPP_VERIFY_TOKEN=una-stringa-lunga-e-casuale

# App secret dell'app Meta (Impostazioni app > Di base > Chiave segreta).
# Firma ogni webhook in arrivo: senza, l'endpoint è aperto a chiunque.
WHATSAPP_APP_SECRET=

# Access token permanente di un system user con permesso whatsapp_business_messaging.
# Il token temporaneo da 24h del pannello va bene solo per le prove.
WHATSAPP_TOKEN=

# ID del numero mittente (WhatsApp > Configurazione API), NON il numero stesso.
WHATSAPP_PHONE_NUMBER_ID=

# Versione della Graph API. Aggiornala consapevolmente: Meta depreca
# le versioni dopo circa due anni.
WHATSAPP_GRAPH_VERSION=v23.0

# --- Claude ---

ANTHROPIC_API_KEY=

# Default: claude-opus-5.
CLAUDE_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Default "low": il servizio clienti è una
# rotta conversazionale dove il cliente aspetta davanti alla chat, e l'effort
# alto si paga in latenza. Alzalo se le domande richiedono più ragionamento.
CLAUDE_EFFORT=low

# Tetto ai token della risposta. Volutamente basso: su WhatsApp si legge dal
# telefono e un messaggio si ferma comunque a 4096 caratteri.
CLAUDE_MAX_TOKENS=1024

# Prompt di sistema. Se lo lasci vuoto viene usato quello di default in
# src/config.ts, che va personalizzato con i dati della tua attività.
# CLAUDE_SYSTEM_PROMPT=

# --- Comportamento ---

PORT=3000

# Dopo quanti minuti di silenzio la conversazione di un contatto viene
# dimenticata e si riparte da zero.
CONVERSATION_TTL_MINUTES=60

# Quanti messaggi (utente + assistente) tenere nel contesto per contatto.
MAX_HISTORY_MESSAGES=20
