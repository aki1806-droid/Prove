# Token API di Picky Assist: Settings -> Developers -> API.
# Non committare mai il valore reale: questo file contiene solo un segnaposto.
PICKY_API_TOKEN=inserisci-qui-il-tuo-token

# Segreto condiviso per validare le chiamate ai webhook (facoltativo ma consigliato).
PICKY_WEBHOOK_SECRET=scegli-una-stringa-casuale
