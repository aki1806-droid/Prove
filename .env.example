# ---------------------------------------------------------------------------
# Credenziali Picky Assist
# Il token si genera dal pannello: Settings -> Developers -> API
# ATTENZIONE: dopo la creazione il token non e' piu' visibile, salvalo subito.
# ---------------------------------------------------------------------------
PICKY_API_TOKEN=

# Base URL delle API. Default: endpoint V4.
#   V4 (consigliato): https://app.pickyassist.com/api/v2
#   V2 (legacy):      https://pickyassist.com/app/api/v2
# Nota: l'endpoint /device-status risponde solo sull'host legacy.
PICKY_BASE_URL=https://app.pickyassist.com/api/v2

# Canale di default per l'invio (vedi src/constants.js):
#   1=WhatsApp Personal  2=WhatsApp Business  3=SMS  5=Messenger
#   8=WhatsApp Official  101=WhatsApp Cloud API  121=WhatsApp Business API
# Con piu' canali collegati usa l'id canale da Settings -> Channels.
PICKY_DEFAULT_APPLICATION=8

# Timeout e retry sulle chiamate uscenti
PICKY_TIMEOUT_MS=15000
PICKY_MAX_RETRIES=2

# Limite di sicurezza lato client: l'API accetta max 90 richieste/minuto
# per progetto, oltre restituisce 429 e i messaggi vengono scartati.
PICKY_RATE_LIMIT_PER_MINUTE=80

# ---------------------------------------------------------------------------
# Server webhook (ricezione messaggi in entrata)
# ---------------------------------------------------------------------------
PORT=3000
WEBHOOK_PATH=/webhook

# Picky Assist non firma le richieste webhook: proteggi l'endpoint con un
# segreto condiviso. Se valorizzato, l'URL da configurare nel pannello diventa
#   https://tuo-dominio.tld/webhook?secret=IL_TUO_SEGRETO
# (accettato anche come header X-Webhook-Secret).
WEBHOOK_SECRET=

# Facoltativo: lista di IP autorizzati separati da virgola.
WEBHOOK_ALLOWED_IPS=

# Log del payload completo in entrata (utile in sviluppo, contiene dati personali)
LOG_RAW_PAYLOAD=false
